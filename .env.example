# Hearthbeat runs in demo mode with no configuration at all: `npm start`.
# Copy this file to .env only if you want live mode. Never commit .env.

# Port the web app listens on
PORT=3000

# --- Live mode (npm run live) -------------------------------------------------
# Short-lived (about 30 minutes) token from the Ring Developer Playground:
# https://developer.amazon.com/ring/console/playground
RING_ACCESS_TOKEN=your_playground_token_here

# Comma-separated device ids from GET /v1/devices.
# "Inside" devices (for example an indoor camera) feed the Rhythm Ring.
# "Doorway" devices (doorbell, porch camera) feed visitor alerts.
RING_INSIDE_DEVICE_IDS=
RING_DOORWAY_DEVICE_IDS=
# A Ring Chime used for the gentle nudge (needs the Chime Controls capability)
RING_CHIME_DEVICE_ID=

# Optional: poll interval for Event History in live mode (milliseconds)
POLL_INTERVAL_MS=30000

# Optional: only needed if you register an app and receive real webhooks.
# This is the HMAC signing key issued at partner onboarding.
RING_HMAC_KEY=your_hmac_signing_key_here

# IANA time zone of the home being cared for, used for "time of day" maths
HOUSEHOLD_TZ=America/Chicago
